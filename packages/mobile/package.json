{
  "name": "@splat-connect/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@splat-connect/types": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.7",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@expo/log-box": "~57.0.1",
    "@expo/metro-runtime": "~57.0.6",
    "@playwright/test": "^1.61.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "EXPO_PACKAGER_HOSTNAME=$(tailscale ip -4) dotenv -e ../../.env.local -e .env.local -- expo start",
    "ios": "EXPO_PACKAGER_HOSTNAME=$(tailscale ip -4) dotenv -e ../../.env.local -e .env.local -- expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "device:fixture": "node scripts/provision-device-parent.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ],
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|expo-linking|expo-constants|expo-status-bar|expo-secure-store|expo-font|react-native-webview|react-native-url-polyfill|react-native-css-interop|react-native-reanimated|react-native-worklets|@testing-library/react-native))"
    ]
  }
}
