{
  "name": "@splat-connect/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/jersey-10": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@splat-connect/types": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/log-box": "~57.0.4",
    "@expo/metro-runtime": "~57.0.14",
    "@playwright/test": "^1.61.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.3",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "EXPO_PACKAGER_HOSTNAME=$(tailscale ip -4) dotenv -e ../../.env.local -e .env.local -- expo start",
    "ios": "EXPO_PACKAGER_HOSTNAME=$(tailscale ip -4) dotenv -e ../../.env.local -e .env.local -- expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "device:fixture": "node scripts/provision-device-parent.mjs",
    "device:build": "rm -rf \"${TMPDIR:-/tmp}/metro-cache\" && expo prebuild -p android --clean && cd android && ./gradlew assembleRelease",
    "device:test": "maestro test .maestro/flows/"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ],
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ]
  }
}
