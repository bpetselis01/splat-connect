{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "splatconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splatconnect.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "This app connects to a local development server to load tutorials."
      }
    },
    "android": {
      "package": "com.splatconnect.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SPLAT Connect uses your camera so you can photograph the toy you adapted for your guide.",
          "photosPermission": "SPLAT Connect uses your photo library so you can pick an existing photo of the toy for your guide.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-router",
      "expo-secure-store"
    ]
  }
}
