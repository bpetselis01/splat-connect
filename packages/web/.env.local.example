# Copy to .env.local and fill in your values.
# Get Supabase values from your project dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API_URL / NEXT_PUBLIC_API_URL are derived from the repo-root .env.local's
# API_PORT (see next.config.ts). Uncomment to point at a different API instance.
# API_URL=http://localhost:3101
# NEXT_PUBLIC_API_URL=http://localhost:3101
