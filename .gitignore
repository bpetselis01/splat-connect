# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# Playwright
packages/web/test-results/
packages/web/playwright-report/
packages/web/blob-report/
packages/web/.last-run.json

# next.js
**/.next/
**/out/

# production
**/dist/
**/build/
# …except the app route of that name. `**/build/` is for compiler output, and it
# silently swallowed app/dashboard/exchanges/build/[id] — a page that was
# written, worked, and would never have been committed.
!packages/web/app/**/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit .env.example files, never actual env files
.env.local
.env*.local
packages/api/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

# claude
.superpowers/
.claude/worktrees/
.claude/settings.local.json
.claude/skills/
.claude/.headroom_wrap_marker.json
# The skills themselves. .claude/skills/ is a directory of symlinks pointing in
# here, so ignoring one without the other left every target showing as
# untracked. These are third-party skills carrying no licence of their own and
# this repo is public — they are synced between machines by copying the folder,
# never by committing it.
.agents/

# git worktrees
.worktrees/

# graphify (regenerated via `graphify update .`)
graphify-out/

.playwright-mcp/

# stray logs
*.log

# Claude Design export of the Soft Pop prototype (46MB) and the
# understand-anything scratch output (12MB). Both are working material,
# not source — see docs/superpowers/specs/2026-09-16-soft-pop-design.md.
Splat Connect frontend overhaul/
.ua/

# Parity harness output — regenerated by scripts/parity/run.js
scripts/parity/shots/
