{
  "name": "splat-connect-workspace",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @splat-connect/api dev",
    "dev:web": "pnpm --filter @splat-connect/web dev",
    "dev:mobile": "pnpm --filter @splat-connect/mobile ios",
    "build": "pnpm --filter @splat-connect/api build && pnpm --filter @splat-connect/web build",
    "typecheck": "pnpm -r typecheck",
    "db:check": "bash scripts/check-migration-drift.sh",
    "db:guards": "bash scripts/check-schema-guards.sh",
    "test:journeys": "node scripts/journeys/check.mjs",
    "test:journeys:write": "node scripts/journeys/render.mjs",
    "test:journeys:unit": "node --test 'scripts/journeys/*.test.mjs'",
    "test:parity:unit": "node --test 'scripts/parity/*.test.js'"
  },
  "devDependencies": {
    "@splat-connect/types": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "tsx": "^4",
    "typescript": "^5"
  }
}
